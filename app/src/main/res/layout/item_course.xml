<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="#16213E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- 课程信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCourseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_course_name"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCourseId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_course_id"
                android:textSize="12sp"
                android:textColor="#AAAAAA" />
        </LinearLayout>

        <!-- XP和难度 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvCourseXp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/item_xp_default"
                android:textSize="14sp"
                android:textColor="#E94560"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCourseDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_beginner"
                android:textSize="12sp"
                android:textColor="#4CAF50" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnBookmark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_check"
            android:background="?selectableItemBackgroundBorderless"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/content_desc_bookmark"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>