<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    tools:context=".MainActivity">

    <!-- 标题栏 -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#16213E"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_python_app_title"
            android:textSize="24sp"
            android:textColor="#E94560"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_version"
            android:textSize="14sp"
            android:textColor="#CCCCCC" />
    </LinearLayout>

    <!-- 统计卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#0F3460"
        app:layout_constraintTop_toBottomOf="@id/llHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTotalUnits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_total_units_default"
                android:textSize="16sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvTotalXp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_total_xp_default"
                android:textSize="16sp"
                android:textColor="#E94560" />

            <TextView
                android:id="@+id/tvDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_difficulty_default"
                android:textSize="16sp"
                android:textColor="#CCCCCC" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 操作按钮 -->
    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="16dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/cardStats">

        <Button
            android:id="@+id/btnStartLearning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_start_learning"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#E94560"
            android:contentDescription="@string/btn_start_learning" />

        <Button
            android:id="@+id/btnViewProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_view_progress"
            android:layout_marginStart="8dp"
            android:backgroundTint="#0F3460"
            android:contentDescription="@string/btn_view_progress" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/llButtons">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_all"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E94560"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBeginner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_beginner"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4CAF50"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipIntermediate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_intermediate"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF9800"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAdvanced"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_advanced"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F44336"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipExpert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_expert"
                android:textColor="#FFFFFF"
                android:backgroundTint="#212121"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 课程列表标题 -->
    <TextView
        android:id="@+id/tvCoursesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_courses_title"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/scrollView" />

    <!-- 课程列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCourses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:contentDescription="@string/tv_courses_title"
        app:layout_constraintTop_toBottomOf="@id/tvCoursesTitle"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F3460"
        app:menu="@menu/menu_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:itemIconTint="#FFFFFF"
        app:itemTextColor="#FFFFFF"/>

</androidx.constraintlayout.widget.ConstraintLayout>